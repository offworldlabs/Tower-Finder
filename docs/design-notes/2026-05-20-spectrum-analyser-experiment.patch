+# ── SpectralMeasurement ranking ───────────────────────────────────────────────
+
+# Three towers at different distances/bands around Atlanta.
+_VHF_DEVICE = _device(freq_mhz=201.0, lat=33.60, lon=-84.388, callsign="WATL")
+_VHF_SYSTEM = _system([_VHF_DEVICE])
+
+_UHF_DEVICE = _device(freq_mhz=533.0, lat=33.93, lon=-84.000, callsign="WUHF")
+_UHF_SYSTEM = _system([_UHF_DEVICE])
+
+
+class TestProcessAndRankMeasurements:
+
+    def test_measurement_fields_present_on_matched_tower(self):
+        """A tower whose frequency matches a measurement gets measured_* fields."""
+        m = SpectralMeasurement(freq_mhz=95.5, snr_db=28.0, obw_fraction=0.72, score=0.85)
+        result = process_and_rank([_FM_SYSTEM], _USER_LAT, _USER_LON, measurements=[m])
+        assert len(result) == 1
+        t = result[0]
+        assert t["frequency_matched"] is True
+        assert t["measured_snr_db"] == 28.0
+        assert t["measured_obw_fraction"] == 0.72
+        assert t["measured_score"] == 0.85
+
+    def test_unmatched_tower_measured_fields_are_none(self):
+        """A tower with no nearby measurement has None for all measured_* fields."""
+        m = SpectralMeasurement(freq_mhz=201.0, score=0.9)  # VHF, not FM
+        result = process_and_rank([_FM_SYSTEM], _USER_LAT, _USER_LON, measurements=[m])
+        assert len(result) == 1
+        t = result[0]
+        assert t["frequency_matched"] is False
+        assert t["measured_score"] is None
+        assert t["measured_snr_db"] is None
+
+    def test_high_score_sorts_before_unmatched(self):
+        """A measured FM tower outranks an unmatched VHF tower regardless of band priority."""
+        m = SpectralMeasurement(freq_mhz=95.5, score=0.9)
+        systems = [_FM_SYSTEM, _VHF_SYSTEM]
+        result = process_and_rank(systems, _USER_LAT, _USER_LON, measurements=[m])
+        assert result[0]["callsign"] == "WXYZ"   # FM — matched, score 0.9
+        assert result[1]["callsign"] == "WATL"   # VHF — unmatched
+
+    def test_higher_score_sorts_first_among_matched(self):
+        """Of two matched towers, the one with higher measured_score ranks first."""
+        m_fm  = SpectralMeasurement(freq_mhz=95.5,  score=0.4)
+        m_vhf = SpectralMeasurement(freq_mhz=201.0, score=0.9)
+        systems = [_FM_SYSTEM, _VHF_SYSTEM]
+        result = process_and_rank(systems, _USER_LAT, _USER_LON, measurements=[m_fm, m_vhf])
+        assert result[0]["callsign"] == "WATL"   # VHF — score 0.9
+        assert result[1]["callsign"] == "WXYZ"   # FM  — score 0.4
+
+    def test_zero_score_matched_sorts_before_unmatched(self):
+        """A matched tower with score=0 still sorts before an unmatched tower."""
+        m = SpectralMeasurement(freq_mhz=95.5, score=0.0)
+        systems = [_FM_SYSTEM, _VHF_SYSTEM]
+        result = process_and_rank(systems, _USER_LAT, _USER_LON, measurements=[m])
+        assert result[0]["callsign"] == "WXYZ"   # FM — matched (score 0)
+        assert result[1]["callsign"] == "WATL"   # VHF — unmatched
+
+    def test_tolerance_boundary_match(self):
+        """Measurement exactly at FREQUENCY_MATCH_TOLERANCE_MHZ away still matches."""
+        m = SpectralMeasurement(freq_mhz=95.5 + FREQUENCY_MATCH_TOLERANCE_MHZ, score=0.8)
+        result = process_and_rank([_FM_SYSTEM], _USER_LAT, _USER_LON, measurements=[m])
+        assert result[0]["frequency_matched"] is True
+
+    def test_tolerance_boundary_no_match(self):
+        """Measurement just beyond tolerance does not match."""
+        m = SpectralMeasurement(freq_mhz=95.5 + FREQUENCY_MATCH_TOLERANCE_MHZ + 0.1, score=0.8)
+        result = process_and_rank([_FM_SYSTEM], _USER_LAT, _USER_LON, measurements=[m])
+        assert result[0]["frequency_matched"] is False
+        assert result[0]["measured_score"] is None
+
+    def test_empty_measurements_list_falls_back_to_default_ranking(self):
+        """Passing measurements=[] behaves identically to measurements=None."""
+        r_none  = process_and_rank([_FM_SYSTEM, _VHF_SYSTEM], _USER_LAT, _USER_LON)
+        r_empty = process_and_rank([_FM_SYSTEM, _VHF_SYSTEM], _USER_LAT, _USER_LON, measurements=[])
+        assert [t["callsign"] for t in r_none] == [t["callsign"] for t in r_empty]
+
+    def test_measurement_without_score_does_not_crash(self):
+        """SpectralMeasurement with score=None is handled gracefully."""
+        m = SpectralMeasurement(freq_mhz=95.5, snr_db=20.0, score=None)
+        result = process_and_rank([_FM_SYSTEM], _USER_LAT, _USER_LON, measurements=[m])
+        assert result[0]["frequency_matched"] is True
+        assert result[0]["measured_score"] is None
