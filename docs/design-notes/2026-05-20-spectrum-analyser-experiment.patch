     }
 
 
+@router.post("/api/towers/profile")
+async def tower_profile(body: RfProfileRequest):
+    """Accept an RF profile from the spectrum analyser and return towers ranked
+    by measured signal quality rather than estimated received power."""
+    source = body.source.lower()
+    if source == "auto":
+        source = _detect_source(body.lat, body.lon)
+    if source not in ("us", "au", "ca"):
+        raise HTTPException(status_code=400, detail="Invalid source. Use: us, au, ca, auto")
+
+    effective_radius = body.radius_km if body.radius_km > 0 else DEFAULT_RADIUS_KM
+    effective_limit  = body.limit     if body.limit     > 0 else DEFAULT_LIMIT
+
+    try:
+        if source == "us":
+            raw = await fetch_fcc_broadcast_systems(body.lat, body.lon, radius_km=effective_radius)
+            if API_KEY:
+                try:
+                    maprad_raw = await fetch_broadcast_systems(
+                        API_KEY, body.lat, body.lon, radius_km=effective_radius, source=source,
+                    )
+                    raw.extend(maprad_raw)
+                except Exception:
+                    logging.warning("Maprad supplement failed, using FCC data only")
+        else:
+            if not API_KEY:
+                raise HTTPException(status_code=500, detail="MAPRAD_API_KEY not configured")
+            raw = await fetch_broadcast_systems(
+                API_KEY, body.lat, body.lon, radius_km=effective_radius, source=source,
+            )
+    except HTTPException:
+        raise
+    except Exception:
+        logging.exception("Tower data fetch failed")
+        raise HTTPException(status_code=502, detail="External service unavailable. Please try again.") from None
+
+    measurements = [
+        SpectralMeasurement(
+            freq_mhz=m.freq_mhz,
+            snr_db=m.snr_db,
+            obw_fraction=m.obw_fraction,
+            score=m.score,
+            power_db=m.power_db,
+            band=m.band,
+        )
+        for m in body.measurements
+    ]
+
+    towers = process_and_rank(
+        raw, body.lat, body.lon,
+        limit=effective_limit,
+        radius_km=effective_radius,
+        measurements=measurements or None,
+    )
+
+    tower_coords = [(t["latitude"], t["longitude"]) for t in towers]
+    elevations = await _batch_lookup_elevations(tower_coords)
+    for t in towers:
+        key = (round(t["latitude"], 6), round(t["longitude"], 6))
+        elev = elevations.get(key)
+        t["elevation_m"] = round(elev, 1) if elev is not None else None
+        if elev is not None and t.get("antenna_height_m") is not None:
+            t["altitude_m"] = round(elev + t["antenna_height_m"], 1)
+        elif elev is not None:
+            t["altitude_m"] = round(elev, 1)
+        else:
+            t["altitude_m"] = None
+
+    matched_count = sum(1 for t in towers if t["frequency_matched"])
+    return {
+        "towers": towers,
+        "query": {
+            "latitude":   body.lat,
+            "longitude":  body.lon,
+            "radius_km":  effective_radius,
+            "source":     source,
+            "measurement_count": len(measurements),
+        },
+        "count":   len(towers),
+        "matched": matched_count,
+    }
+
+
 @router.get("/api/health")
