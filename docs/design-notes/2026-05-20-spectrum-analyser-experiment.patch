+class TestTowerProfile:
+    """Tests for POST /api/towers/profile."""
+
+    @pytest.fixture()
+    def _mock_fcc(self):
+        with unittest.mock.patch(
+            "routes.towers.fetch_fcc_broadcast_systems",
+            new=unittest.mock.AsyncMock(return_value=[_MOCK_SYSTEM]),
+        ), unittest.mock.patch(
+            "routes.towers._batch_lookup_elevations",
+            new=unittest.mock.AsyncMock(return_value={}),
+        ):
+            yield
+
+    def test_valid_request_returns_200(self, client, _mock_fcc):
+        r = client.post("/api/towers/profile", json={
+            "lat": 33.749, "lon": -84.388,
+            "measurements": [{"freq_mhz": 95.5, "snr_db": 25.0, "score": 0.85}],
+        })
+        assert r.status_code == 200
+
+    def test_response_shape(self, client, _mock_fcc):
+        r = client.post("/api/towers/profile", json={
+            "lat": 33.749, "lon": -84.388,
+            "measurements": [{"freq_mhz": 95.5, "snr_db": 25.0, "score": 0.85}],
+        })
+        body = r.json()
+        assert "towers" in body
+        assert "count" in body
+        assert "matched" in body
+        assert "query" in body
+        assert body["query"]["measurement_count"] == 1
+
+    def test_matched_tower_has_measured_fields(self, client, _mock_fcc):
+        r = client.post("/api/towers/profile", json={
+            "lat": 33.749, "lon": -84.388,
+            "measurements": [{"freq_mhz": 95.5, "snr_db": 25.0, "obw_fraction": 0.72, "score": 0.85}],
+        })
+        body = r.json()
+        assert body["matched"] == 1
+        t = body["towers"][0]
+        assert t["frequency_matched"] is True
+        assert t["measured_snr_db"] == 25.0
+        assert t["measured_obw_fraction"] == 0.72
+        assert t["measured_score"] == 0.85
+
+    def test_empty_measurements_still_returns_towers(self, client, _mock_fcc):
+        r = client.post("/api/towers/profile", json={
+            "lat": 33.749, "lon": -84.388,
+            "measurements": [],
+        })
+        assert r.status_code == 200
+        assert r.json()["count"] >= 1
+
+    def test_missing_lat_returns_422(self, client):
+        r = client.post("/api/towers/profile", json={"lon": -84.388, "measurements": []})
+        assert r.status_code == 422
+
+    def test_lat_out_of_range_returns_422(self, client):
+        r = client.post("/api/towers/profile", json={
+            "lat": 999, "lon": -84.388, "measurements": [],
+        })
+        assert r.status_code == 422
+
+    def test_invalid_source_returns_400(self, client, _mock_fcc):
+        r = client.post("/api/towers/profile", json={
+            "lat": 33.749, "lon": -84.388,
+            "measurements": [], "source": "zz",
+        })
+        assert r.status_code == 400
+
+    def test_upstream_failure_returns_502(self, client):
+        with unittest.mock.patch(
+            "routes.towers.fetch_fcc_broadcast_systems",
+            new=unittest.mock.AsyncMock(side_effect=Exception("FCC down")),
+        ):
+            r = client.post("/api/towers/profile", json={
+                "lat": 33.749, "lon": -84.388, "measurements": [],
+            })
+        assert r.status_code == 502
