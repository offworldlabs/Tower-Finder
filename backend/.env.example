MAPRAD_API_KEY=your_api_key_here

# Auth — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth — GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth — JWT secret (generate a random string for production)
JWT_SECRET=change-me-in-production

# Auth — comma-separated admin emails
AUTH_ADMIN_EMAILS=admin@retina.fm

# Alerting — webhook for health/critical alerts (Slack/Discord/PagerDuty incoming webhook)
ALERT_WEBHOOK_URL=
# Re-notify cooldown per alert type, seconds (default 300)
ALERT_COOLDOWN_S=300
# Dead-man's-switch: ping this URL periodically (e.g. a Healthchecks.io check).
# The external service alerts when pings stop. See docs/alerting.md.
HEARTBEAT_URL=
