[Unit]
# ⚠️  FALLBACK ONLY — NOT the production mechanism. The prod fleet runs as the
# `fleet` Compose service in docker-compose.yml (restart: unless-stopped), which
# is what actually serves testmap.retina.fm and survives reboots. Keep this unit
# ONLY as an emergency way to run the fleet as a host process (e.g. if you ever
# need it without rebuilding the image).
#
# 🚫  DO NOT run this alongside the Compose `fleet` service — two fleets would
# both push synthetic traffic and double-count nodes/aircraft. Before enabling
# this, `docker compose stop fleet` first; before re-enabling Compose,
# `systemctl disable --now fleet` first. Exactly one of the two, ever.
#
# Runs the same orchestrator invocation as the old transient systemd-run unit,
# but as a proper enabled service so it would come back on boot.
#
# Install (on the droplet), only in the fallback scenario above:
#   docker compose stop fleet         # ensure the Compose fleet is down first
#   cp /opt/tower-finder/deploy/fleet.service /etc/systemd/system/fleet.service
#   systemctl daemon-reload
#   systemctl enable --now fleet.service
#   systemctl status fleet.service --no-pager
Description=RETINA synthetic fleet simulator (testmap.retina.fm ground-truth + nodes)
Documentation=file:/opt/tower-finder/docker-compose.yml
# Start after Docker so the tower-finder app (TCP ingest on :3012) is coming up.
# We don't hard-require it: --connect-retries 999 lets the orchestrator wait for
# :3012 to open on its own, so boot-ordering races can't strand the fleet.
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=exec
WorkingDirectory=/opt/tower-finder

# RADAR_API_KEY lives in backend/.env (same file docker-compose loads). Sourcing
# it here keeps one source of truth and avoids baking the secret into the unit.
# The orchestrator refuses ground-truth push without it, so a missing key fails
# loudly rather than silently 401-ing.
EnvironmentFile=/opt/tower-finder/backend/.env

# The FLEET SHAPE mirrors the source of truth — the `fleet` service in
# /opt/tower-finder/docker-compose.yml (200 nodes, 40s interval, adsb mode,
# 60-100 aircraft). If you change THOSE there, update them here too (no automated
# tie-back). NOTE: --validation-url and --connect-retries intentionally DIFFER
# from compose: as a host process this unit isn't on the compose network, so it
# pushes via https://localhost (not http://tower-finder:8000) and needs many
# retries (it has no depends_on to wait for the app). Do not "sync" those two.
ExecStart=/usr/bin/python3 -m retina_simulation.orchestrator \
    --nodes 200 \
    --mode adsb \
    --validation-url https://localhost \
    --concurrency 20 \
    --connect-retries 999 \
    --interval 40.0 \
    --time-scale 1.0 \
    --min-aircraft 60 \
    --max-aircraft 100

# Recover from crashes and from the app restarting underneath us.
Restart=always
RestartSec=5
# Node generation queries the Tower API sequentially and can take a minute+;
# don't let systemd's start-timeout kill it mid-generation.
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
