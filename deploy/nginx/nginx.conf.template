# ${HOST_LEGACY_REDIRECT} — standalone tower-finder-service (a separate compose
# stack reached over the shared `retina-edge` docker network). Only production
# runs that stack; on staging this vhost answers 502, which is expected and
# harmless — keeping the block identical is what lets the parity check assert
# the two rendered configs match.
server {
    # RETINA_IF TLS
    listen 443 ssl;
    # RETINA_ELSE
    listen 80;
    # RETINA_ENDIF
    server_name ${HOST_LEGACY_REDIRECT};

    # RETINA_IF TLS
    # RETINA_INCLUDE snippets/tls.conf
    # RETINA_ENDIF
    # RETINA_INCLUDE snippets/security-headers-api.conf

    location / {
        limit_req zone=api burst=60 nodelay;
        # Resolve the upstream via Docker's embedded DNS at request time (note
        # the variable) so this nginx still boots when the tower-finder-service
        # stack is down — a missing upstream then 502s instead of failing boot.
        resolver 127.0.0.11 valid=10s;
        set $tfs_upstream tower-finder-service;
        proxy_pass http://$tfs_upstream:8000;
        # RETINA_INCLUDE snippets/proxy-common.conf
        proxy_read_timeout 120s;
    }
}
