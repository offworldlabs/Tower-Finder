# Repo-root ./.env for the STAGING droplet (gitignored).
#
# The deploy workflow copies this into place on every run, so the droplet's
# .env cannot drift, go missing or name another environment. You should not
# need to place it by hand; if you are setting up a box before its first
# deploy, `cp deploy/env.staging.example .env`.
#
# COMPOSE_FILE makes `docker compose <anything>` resolve to base + staging
# overlay on this host, so the deploy workflow and a human debugging over SSH
# type the same commands they would on production. Without it, a bare
# `docker compose up` would start the base alone, which start.sh refuses to
# boot (no RETINA_ENV).
#
# Application secrets and per-host tuning do NOT belong here — they live in
# backend/.env, which both services load via `env_file`.
COMPOSE_FILE=docker-compose.yml:docker-compose.staging.yml

# Pinned explicitly. Compose otherwise derives the project name from the
# directory name, and named volumes are prefixed with the project name, so
# moving the deploy directory would silently point compose at volumes that do
# not exist. It would then create empty ones and start healthy and blank.
#
# This file, not the droplet's .env, is what every deploy installs (it is
# copied into place on every run, see the note at the top of this file), so
# a value set by hand on the droplet survives only until the next deploy. The
# value below must be changed here, in the same change that migrates this
# environment's volumes to the new project name, or the next deploy will put
# the old name back and compose will remount the pre-migration volumes.
COMPOSE_PROJECT_NAME=tower-finder
