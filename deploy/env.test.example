# Repo-root ./.env for the retina-test DROPLET — copy to ./.env (gitignored).
#
#   cp deploy/env.test.example .env
#
# COMPOSE_FILE makes `docker compose <anything>` resolve to base + test overlay
# on this host, so the deploy path and a human debugging over SSH type the same
# commands they would on staging or production. Without it, a bare
# `docker compose up` would start the base alone, which start.sh refuses to boot
# (no RETINA_ENV).
#
# Application secrets and per-host tuning do NOT belong here — they live in
# backend/.env, which both services load via `env_file`.
COMPOSE_FILE=docker-compose.yml:docker-compose.test.yml
