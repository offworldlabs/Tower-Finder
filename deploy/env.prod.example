# Repo-root ./.env for the PRODUCTION droplet — copy to ./.env (gitignored).
#
#   cp deploy/env.prod.example .env
#
# COMPOSE_FILE makes `docker compose <anything>` resolve to base + prod overlay
# on this host, so the deploy workflow and a human debugging over SSH type the
# same commands they would on staging. Without it, a bare `docker compose up`
# would start the base alone, which start.sh refuses to boot (no RETINA_ENV).
#
# Application secrets and per-host tuning do NOT belong here — they live in
# backend/.env, which both services load via `env_file`.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
